# Copy to `.env.local` (Next.js) or `.env` (scripts) and fill in.

# YouTube Data API v3 key. Create at https://console.cloud.google.com/apis/credentials
# Used by scripts/match-youtube.ts; not required for the running app (the site uses
# the public RSS feed).
YOUTUBE_API_KEY=

# YouTube channel handle (with or without leading @). Defaults to @CoachHayesHudl
# when unset.
CHANNEL_HANDLE=@CoachHayesHudl

# CollegeFootballData.com API key. Free signup at https://collegefootballdata.com/key
# Used server-side by lib/cfbd/* to enrich the Big Board with stars, rankings,
# height/weight, school, and hometown. Never sent to the browser.
CFBD_API_KEY=

# ---------------------------------------------------------------------------
# Big Board source — Google Sheet published to web as CSV.
#
# In your sheet: File → Share → Publish to web → choose the relevant tab →
# CSV → Publish. Paste the long URL it gives you here. The sheet must have
# the column headers documented in README.md → "Big Board".
# ---------------------------------------------------------------------------
SHEET_CSV_URL=

# Optional. The regular edit URL for the sheet (the one in your browser when
# you're editing). If set, /admin/refresh shows an "Open the Google Sheet"
# button. Safe to commit publicly only if the sheet itself is shareable.
SHEET_EDIT_URL=

# ---------------------------------------------------------------------------
# Admin auth. Gates /admin/* via proxy.ts + lib/admin/auth.ts.
# Single shared password plus an HMAC-signed, expiring session cookie.
# SESSION_SECRET must be at least 16 chars; generate with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Content database (Drizzle + libSQL). Read by lib/db/client.ts.
# Local default is a file under .data/ — set these only to point at hosted
# libSQL/Turso, which is required for any deploy where writes must survive
# (a serverless filesystem does not persist, and the admin's whole job is
# writing).
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_AUTH_TOKEN=
